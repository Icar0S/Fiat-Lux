# Copie para .env e preencha. Nunca versione o .env.
# Servidor de LLM (API HTTP: POST /v1/chat e GET /v1/models; guia, seção 8). Sem ele, a
# Palavra do Dia sai só com o Evangelho do dia e uma oração fixa.
FIATLUX_LLM_URL=              # raiz do servidor, ex.: https://llm.exemplo.com (sem /v1)
FIATLUX_LLM_CHAVE=            # vai como Authorization: Bearer <chave>; vazio se não pede
FIATLUX_LLM_MODELO=           # vazio: o padrão do servidor (vale para todas as tarefas)
FIATLUX_LLM_MODELO_GERACAO=   # opcional: seleção e redação com outro modelo
FIATLUX_LLM_SEM_RACIOCINIO=   # opcional: marca que desliga o raciocínio (qwen3: /no_think)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_IDS=            # separados por vírgula
TELEGRAM_ADMIN_CHAT_ID=
FIATLUX_PERFIL=catolico       # catolico | evangelico | ecumenico
FIATLUX_TZ=America/Fortaleza
FIATLUX_CUSTO_MAX_MENSAL_USD=10
FIATLUX_ESTADO=data/estado/estado.sqlite
HF_HOME=.cache/huggingface
# SMTP (opcional, entrega por e-mail)
SMTP_HOST=
SMTP_PORT=587
SMTP_USUARIO=
SMTP_SENHA=
EMAIL_DESTINATARIOS=
